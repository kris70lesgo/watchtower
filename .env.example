# Documented testnet defaults; confirm with Meta Earth before a live deployment.
NEXT_PUBLIC_ME_CHAIN_ID=400
NEXT_PUBLIC_ME_EVM_RPC=http://118.175.0.249:8545
# Browser deployments over HTTPS need an HTTPS EVM endpoint.
NEXT_PUBLIC_ME_MARKET=
NEXT_PUBLIC_ME_ORACLE=
NEXT_PUBLIC_ME_TOKEN=
NEXT_PUBLIC_ME_USDC=
NEXT_PUBLIC_ME_TREASURY=
NEXT_PUBLIC_ME_MOCK_USDC=true
NEXT_PUBLIC_ME_PUBLISHER=0x1b77aE05cd23C514A1De304b6b771513f6eFa780
# Official ME Hub REST endpoint (optional; enables public ME ID lookup).
NEXT_PUBLIC_ME_REST=https://beta-hub-1317.explorer-testnet.me
# Optional EVM explorer base URL; leave blank until confirmed by organizers.
NEXT_PUBLIC_ME_EXPLORER=
# Local-only testnet key, used by deploy script. NEVER prefix with NEXT_PUBLIC_.
ME_DEPLOYER_KEY=
# Optional existing six-decimal ERC-20 on ME testnet. Blank deploys explicitly labeled mock USDC.
ME_PAYMENT_TOKEN=

# Optional: your own public Privy app ID; blank preserves the existing client configuration.
NEXT_PUBLIC_PRIVY_APP_ID=
